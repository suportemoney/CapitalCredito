[Unit]
Description=Django Server – CapitalCredito
# Espera o MySQL ficar pronto — evita 502 quando o Django sobe antes do socket
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=capitalcredito
Group=capitalcredito
WorkingDirectory=/home/capitalcredito/sistema-capitalcredito
Environment="PATH=/home/capitalcredito/sistema-capitalcredito/ubvenv/bin"
Environment="DJANGO_SETTINGS_MODULE=setup.settings"

# --noreload: o systemd controla o processo; sem isso o reloader fica zumbi e a 6001 morre
ExecStart=/home/capitalcredito/sistema-capitalcredito/ubvenv/bin/python \
    /home/capitalcredito/sistema-capitalcredito/manage.py runserver 127.0.0.1:6001 --noreload

Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
